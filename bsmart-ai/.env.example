# BISmart AI Environment Configuration

# Application
APP_ENV=development
APP_NAME="BISmart AI"
DEBUG=True
PORT=8000

# Database
# Production PostgreSQL: postgresql://postgres:password@localhost:5432/bismart_db
# Local fallback (auto-detected if postgres is unavailable): sqlite:///./bismart.db
DATABASE_URL=sqlite:///./bismart.db
# MongoDB Atlas Cloud Database URI
MONGODB_URI=mongodb+srv://Manish:<db_password>@cluster0.kvzwi0r.mongodb.net/BISSystem?retryWrites=true&w=majority&appName=Cluster0

# Authentication
JWT_SECRET=bismart_super_secret_jwt_key_sih2026_secure_random_string_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
# Set your Gemini / OpenAI / Groq API key here. If omitted or set to 'demo', a realistic grounded fallback generator is used.
LLM_API_KEY=demo
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Bhashini / Speech Services (Digital India)
BHASHINI_API_KEY=demo
BHASHINI_USER_ID=demo_user
BHASHINI_PIPELINE_ID=demo_pipeline
BIS_OFFICIAL_API_URL=https://www.services.bis.gov.in/php/BIS_2.0/bisconnect/

# Storage
UPLOAD_DIR=./data/documents
